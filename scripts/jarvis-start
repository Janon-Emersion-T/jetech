#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
UI_DIR="${ROOT_DIR}/apps/desktop-ui"
LOG_DIR="${ROOT_DIR}/runtime/logs"
SERVICES_ONLY="${1:-}"

mkdir -p "${LOG_DIR}"

systemctl --user daemon-reload
systemctl --user start jarvis-stack.target

for _ in $(seq 1 60); do
  if curl -fsS http://127.0.0.1:8000/api/v1/health >/dev/null 2>&1; then
    break
  fi
  sleep 0.5
done

if [[ "${SERVICES_ONLY}" == "--services-only" ]]; then
  exit 0
fi

if pgrep -af "${UI_DIR}/node_modules/electron/dist/electron \\." >/dev/null 2>&1; then
  echo "Jarvis desktop is already running."
  exit 0
fi

cd "${UI_DIR}"
unset ELECTRON_RUN_AS_NODE
setsid env JARVIS_BRAIN_API_URL="http://127.0.0.1:8000" npm run desktop >>"${LOG_DIR}/desktop-ui.log" 2>&1 < /dev/null &
disown || true

echo "Jarvis services started and desktop launch requested."
